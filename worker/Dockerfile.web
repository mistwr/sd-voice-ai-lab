FROM public.ecr.aws/docker/library/python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIPER_MODEL=/app/voices/lumin-ptpt.onnx \
    HF_HOME=/opt/hf-cache \
    LOCAL_WHISPER_MODEL=small \
    LOCAL_WHISPER_CPU_THREADS=2 \
    LOCAL_WHISPER_WORKERS=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-web.txt .
RUN pip install --no-cache-dir -r requirements-web.txt

RUN mkdir -p /app/voices /opt/hf-cache \
    && python -c "from faster_whisper import WhisperModel; WhisperModel('small', device='cpu', compute_type='int8', cpu_threads=2, num_workers=2)" \
    && python -c "import urllib.request; urllib.request.urlretrieve('https://huggingface.co/rhasspy/piper-voices/resolve/main/pt/pt_PT/tug%C3%A3o/medium/pt_PT-tug%C3%A3o-medium.onnx?download=true','/app/voices/lumin-ptpt.onnx'); urllib.request.urlretrieve('https://huggingface.co/rhasspy/piper-voices/resolve/main/pt/pt_PT/tug%C3%A3o/medium/pt_PT-tug%C3%A3o-medium.onnx.json?download=true','/app/voices/lumin-ptpt.onnx.json')"

COPY web_agent.py lead_capture.py supabase_client.py local_whisper_stt.py piper_tts.py chatterbox_tts.py kokoro_remote_tts.py openvoice_tts.py piper_catalog_tts.py ./

RUN python web_agent.py download-files || true

CMD ["python", "web_agent.py", "start"]
