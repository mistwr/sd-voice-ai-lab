# Current web agent: Groq for LLM, LiveKit Inference xAI for PT-PT voice
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LUMIN_TTS_PROVIDER=xai

# LiveKit
LIVEKIT_URL=wss://o-teu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Trunk SIP outbound criado no LiveKit (Telephony > SIP Trunks)
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxx

# LiveKit Inference — usa a mesma API key/secret do projeto LiveKit acima,
# não é preciso chave separada de OpenAI/Deepgram/Cartesia.
SOFIA_VOICE_ID=

# Supabase — SERVICE ROLE KEY, NUNCA usar esta chave no frontend
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SD Dialer lead sync (only consented outbound calls)
SD_DIALER_SUPABASE_URL=
SD_DIALER_SUPABASE_ANON_KEY=
SD_DIALER_LEAD_API_KEY=
